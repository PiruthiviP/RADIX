# App Configurations
APP_ENV=development
APP_NAME=zagent-001-v2
API_PORT=8010
DB_PATH=data/company_intelligence.db
METADATA_PATH=meta_data_complete.json
MAX_RETRY_ROUNDS=2
RESEARCH_TIMEOUT_SECONDS=8

# LangSmith Configuration
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zagent-001-v2
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_TRACING_V2=true

# Model Provider configurations
# At least one provider API Key must be set
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_WEB_SEARCH_ENABLED=true

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_USE_TAVILY_SEARCH=true
TAVILY_API_KEY=
TAVILY_MAX_RESULTS=5

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_WEB_SEARCH_ENABLED=true

# Supabase Configurations
SUPABASE_URL=
SUPABASE_ANON_KEY=
USE_SUPABASE=false
